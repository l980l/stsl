# Godot 4+ specific ignores
.godot/
/android/

# 임포트된 에셋 (재생성 가능)
*.import
*.translation

# 오디오 에셋 — 로컬에서만 관리
assets/audio/

# 아트 에셋 — git 미추적, 로컬에서 직접 관리 (라인 SVG 아이콘 제외)
assets/art/backgrounds/
assets/art/cards/
assets/art/chapters/
assets/art/characters/
assets/art/events/
assets/art/heroes/
assets/art/scenes/
assets/art/ui/intent/
assets/art/ui/relic/
assets/art/ui/status/
assets/art/ui/synergy/
# assets/art/ui/icon_settings.svg 및 assets/art/ui/map/ 은 추적 대상

# 모노 빌드 결과물
.mono/
data_*/
mono_crash.*.json

# 내보내기 템플릿
export_presets.cfg

# 환경변수
.env

# OS
.DS_Store
Thumbs.db

# 로컬 설정
.claude/
docs/.obsidian/

# 도감 (generate_catalog.gd로 재생성 가능)
docs/catalog/*.csv
docs/catalog/*.md
!docs/catalog/README.md
.worktrees/

# 프레임 스파이크 로그 (로컬 디버그용)
log/
