; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="STSL"
run/main_scene="res://scenes/main_menu/main_menu_scene.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"
config/run/main_scene="res://scenes/main_menu/main_menu_scene.tscn"

[autoload]

GameManager="*res://autoload/game_manager.gd"
TeamManager="*res://autoload/team_manager.gd"
DeckManager="*res://autoload/deck_manager.gd"
BattleManager="*res://autoload/battle_manager.gd"
SaveManager="*res://autoload/save_manager.gd"
ProgressManager="*res://autoload/progress_manager.gd"
DebugManager="*res://autoload/debug_manager.gd"
LocaleManager="*res://autoload/locale_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://resources/theme/global_theme.tres"

[internationalization]

locale/translations=PackedStringArray("res://resources/translations/strings_battle.en.translation", "res://resources/translations/strings_battle.ko.translation", "res://resources/translations/strings_card.en.translation", "res://resources/translations/strings_card.ko.translation", "res://resources/translations/strings_enemy.en.translation", "res://resources/translations/strings_enemy.ko.translation", "res://resources/translations/strings_event.en.translation", "res://resources/translations/strings_event.ko.translation", "res://resources/translations/strings_hero.en.translation", "res://resources/translations/strings_hero.ko.translation", "res://resources/translations/strings_relic.en.translation", "res://resources/translations/strings_relic.ko.translation", "res://resources/translations/strings_status.el.translation", "res://resources/translations/strings_status.en.translation", "res://resources/translations/strings_status.es.translation", "res://resources/translations/strings_status.fr.translation", "res://resources/translations/strings_status.it.translation", "res://resources/translations/strings_status.ja.translation", "res://resources/translations/strings_status.ko.translation", "res://resources/translations/strings_status.zh.translation", "res://resources/translations/strings_synergy.en.translation", "res://resources/translations/strings_synergy.ko.translation", "res://resources/translations/strings_ui.el.translation", "res://resources/translations/strings_ui.en.translation", "res://resources/translations/strings_ui.es.translation", "res://resources/translations/strings_ui.fr.translation", "res://resources/translations/strings_ui.it.translation", "res://resources/translations/strings_ui.ja.translation", "res://resources/translations/strings_ui.ko.translation", "res://resources/translations/strings_ui.zh.translation")
locale/fallback="ko"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
